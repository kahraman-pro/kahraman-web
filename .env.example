# kahraman.pro environment variables
# Copy to .env.local for local development, and set the same keys in the hosting panel.
# NEXT_PUBLIC_* values are inlined at build time: set them before the build runs.

# REQUIRED. Public URL of the site, no trailing slash. Used for canonical URLs,
# Open Graph tags, JSON-LD, the sitemap and robots.txt. The build fails without it.
NEXT_PUBLIC_SITE_URL=

# Optional. Calendly / Cal.com link. When set, every contact button becomes
# "Book a free 30 minute call" and opens this link instead of an email.
NEXT_PUBLIC_BOOKING_URL=

# Optional. Google Search Console, HTML tag method: the content of the meta tag.
# (The file method is in place as well: public/google4e5b42ef971a8daa.html)
GOOGLE_SITE_VERIFICATION=

# Optional. Bing Webmaster Tools: the content of the msvalidate.01 meta tag.
# (The file method is in place as well: public/BingSiteAuth.xml)
BING_SITE_VERIFICATION=
